# Copy to .env to change any of these. Every value below is also the default,
# so the project runs without a .env file at all.

# --- PostgreSQL (used by docker compose and by the backend) ------------------
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic

# --- Ports published on localhost ---------------------------------------------
# Postgres is on 5433 rather than 5432 so it does not collide with a Postgres
# already running on your machine.
POSTGRES_PORT=5433
# The FastAPI server (API docs at /docs).
BACKEND_PORT=8000
# The web app.
FRONTEND_PORT=8080

# --- Application ---------------------------------------------------------------
# Time zone used when a timestamp is shown as a calendar date (patient summaries).
CLINIC_TIMEZONE=America/Chicago

# How much the API logs. INFO includes one line per request; DEBUG adds health checks.
LOG_LEVEL=INFO

# --- LLM-written patient summaries (optional) ---------------------------------
# Leave every key empty and summaries are written by the built-in template.
# Set a key and the narrative is written by that provider, falling back to the
# template if the provider fails. Enabling this sends the patient's first name,
# age, status, conditions, medications, allergies and notes to that provider.
#
# auto      use the first provider below that has a key (default)
# template  never call an LLM, whatever keys are set
# deepseek | openai | anthropic   make that provider the default
SUMMARY_PROVIDER=auto

DEEPSEEK_API_KEY=
# DeepSeek V4.1 Flash
DEEPSEEK_MODEL=deepseek-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Only when running the backend outside Docker -----------------------------
# Where the backend finds Postgres. The defaults match the compose file above.
# POSTGRES_HOST=localhost
# A full SQLAlchemy URL here overrides the POSTGRES_* settings.
# DATABASE_URL=postgresql+psycopg://clinic:clinic@localhost:5433/clinic
